{
  "rules": {
    ".read": false,
    ".write": false,

    "access": {
      "$user": {
        ".read": "auth != null && auth.token.email != null && auth.token.email.toLowerCase() === $user + '@pickem.app'",
        ".write": false
      }
    },

    "leagues": {
      "$league": {
        ".read": "auth != null && auth.token.email != null && auth.token.email.toLowerCase().endsWith('@pickem.app') && root.child('access').child(auth.token.email.toLowerCase().replace('@pickem.app', '')).child('leagues').child($league).val() === true",
        ".write": "auth != null && auth.token.email != null && auth.token.email.toLowerCase().endsWith('@pickem.app') && root.child('access').child(auth.token.email.toLowerCase().replace('@pickem.app', '')).child('leagues').child($league).val() === true"
      }
    }
  }
}
